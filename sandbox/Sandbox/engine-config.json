{
  "Audio": {
    "EnableSound": true,
    "Volume": 1.0
  },
  "Core": {
    //"AssetsRootDirectoryPath": "Assets",
    "AssetsRootDirectoryPath": ".",
    "CustomGameLoopSteps": [],
    "EnableGCLogging": false,
    "FixedUpdatesPerFrameLimit": 30,
    "FixedUpdatesPerSecond": 60,
    "LogLevel": "Debug",
    "ShowAllEntitiesCount": false,
    "ShowRootEntitiesCount": false,
    "ShowFps": true,
    "ShowFrameTime": false,
    "ShowGameLoopStatistics": false,
    "ShowTotalFrames": false,
    "ShowTotalTime": false,
    //"StartUpScene": ""
    "StartUpSceneBehavior": "GamepadControllerSandbox"
  },
  "Physics": {
    "Substeps": 1,
    "VelocityIterations": 4,
    "PositionIterations": 4,
    "PenetrationTolerance": 0.01,
    "TileSize": {
      "Width": 50,
      "Height": 50
    },
    "BroadPhaseGridCellSize": {
      "Width": 256,
      "Height": 256
    },
    "EnableDebugRendering": true
  },
  "Rendering": {
    "EnableVSync": false,
    "BufferingMode": "TripleBuffering",
    "ShowRenderingStatistics": false,
    "SortingLayersOrder": [
      "Default",
      "UI"
    ]
  },
  "Windowing": {
    "AllowWindowResizing": true,
    "CursorVisible": true,
    "DisplayMode": "Windowed",
    "WindowClientSize": {
      "Width": 1280,
      "Height": 720
    }
  }
}